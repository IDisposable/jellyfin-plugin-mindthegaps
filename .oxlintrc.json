{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "ApiClient": "readonly",
    "Dashboard": "readonly",
    "Emby": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", { "caughtErrors": "none" }]
  },
  "overrides": [
    {
      "files": ["**/mindthegaps.common.js", "**/mindthegaps.report.*.js"],
      "rules": { "no-unused-vars": "off" }
    },
    {
      "files": ["**/mindthegaps.common.js", "**/mindthegaps.report.*.js", "**/mindthegaps.settings.js"],
      "rules": { "no-var": "error" }
    },
    {
      "files": ["**/mindthegaps.settings.js"],
      "rules": { "prefer-const": "error" }
    }
  ]
}
