<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">10.11.0</JellyfinVersion>
    <!--
      Target framework for the Jellyfin ABI above. Both .csproj files read $(PluginFramework) rather than
      hard-coding a TFM. CI must pass this (not -p:TargetFramework=): MSBuild strips TargetFramework from
      the global properties it hands to the implicit restore, so NuGet would resolve packages for the
      .csproj's literal TFM and fail with NU1202 on any other ABI row.
    -->
    <PluginFramework Condition="'$(PluginFramework)' == ''">net9.0</PluginFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Jellyfin.Controller" Version="$(JellyfinVersion)" />
    <PackageVersion Include="Jellyfin.Model" Version="$(JellyfinVersion)" />
    <PackageVersion Include="Jellyfin.Common" Version="$(JellyfinVersion)" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="TMDbLib" Version="3.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
  </ItemGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
</Project>
